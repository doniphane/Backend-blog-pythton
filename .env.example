# Local development / docker-compose env
DATABASE_URL=postgresql+psycopg://blog:blogpass@db:5432/blogdb
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000

# --- Rôles ---
# Comptes "user" par défaut (lecture). Seuls les admins peuvent publier.
# Emails promus admin automatiquement à l'inscription (séparés par des virgules).
ADMIN_EMAILS=moi@exemple.com

# --- Stockage objet S3 / MinIO (miniatures des posts) ---
# Endpoint vu depuis votre poste (navigateur + API en local).
MINIO_ENDPOINT=http://localhost:9000
# Identifiants MinIO (console http://localhost:9001). À surcharger dans un
# vrai fichier .env (jamais commité) — ne pas laisser les valeurs par défaut en prod.
MINIO_ACCESS_KEY=noelson
# MinIO exige >= 8 caractères : "noelson" seul est refusé au démarrage.
# L'instance locale tourne avec "noelson01" — gardez cette valeur en dev.
MINIO_SECRET_KEY=noelson01
MINIO_BUCKET=minuaturepost
MINIO_SECURE=false
# URL publique des fichiers. Vide = dérivée de MINIO_ENDPOINT.
# En docker, si le navigateur doit joindre MinIO via localhost, garder http://localhost:9000.
MINIO_PUBLIC_URL=http://localhost:9000
